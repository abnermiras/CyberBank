# Copie para .env e preencha. O .env NUNCA e versionado; este arquivo, sim
# (docs/07-operacao/build-e-run.md).
#
# Nenhum valor aqui: segredo com valor padrao e como uma senha de desenvolvimento
# chega em producao. Variavel obrigatoria ausente derruba a subida.

# A conexao da aplicacao — o papel NAO-dono, sem BYPASSRLS
DB_URL=
DB_APP_USER=
DB_APP_PASSWORD=

# O papel que roda as migrations
DB_OWNER_USER=
DB_OWNER_PASSWORD=

# Superusuario de bootstrap do conteiner do Postgres (compose.yml).
# Nao e o dono das tabelas nem a aplicacao.
POSTGRES_SENHA_ADMIN=

# Argon2id — calibrado por host, e passo de instalacao
# (docs/01-arquitetura/seguranca.md)
ARGON2_MEMORIA=
ARGON2_ITERACOES=
ARGON2_PARALELISMO=

# Senha de app do Gmail, so para recuperar senha (ADR-0007)
SMTP_USUARIO=
SMTP_SENHA_DE_APP=

# O que entra no link de recuperacao de senha
CYBERBANK_URL_BASE=
